@node Display Settings
@section Display Settings

@defopt dired-video-thumbnail-size
Width of generated thumbnails in pixels. Default: @code{200}.

@lisp
(setq dired-video-thumbnail-size 250)
@end lisp
@end defopt

@defopt dired-video-thumbnail-display-height
Display height of thumbnails in the buffer. Set to @code{nil} to use actual
thumbnail size. Default: @code{150}.

@lisp
(setq dired-video-thumbnail-display-height 180)
@end lisp
@end defopt

@defopt dired-video-thumbnail-columns
Number of thumbnail columns in the display buffer. Only used when
@code{dired-video-thumbnail-wrap-display} is @code{nil}. Default: @code{4}.

@lisp
(setq dired-video-thumbnail-columns 5)
@end lisp
@end defopt

@defopt dired-video-thumbnail-wrap-display
Whether to wrap thumbnails to fill the buffer width. When non-@code{nil},
thumbnails flow naturally and wrap based on window width. When @code{nil},
a fixed number of columns is used. Default: @code{t}.

@lisp
(setq dired-video-thumbnail-wrap-display nil)
@end lisp
@end defopt

@defopt dired-video-thumbnail-spacing
Spacing between thumbnails in pixels when using wrap display. Default: @code{4}.

@lisp
(setq dired-video-thumbnail-spacing 8)
@end lisp
@end defopt

@node Cache Settings
@section Cache Settings

@defopt dired-video-thumbnail-cache-dir
Directory for caching video thumbnails. Default:
@file{~/.emacs.d/dired-video-thumbnails/}.

@lisp
(setq dired-video-thumbnail-cache-dir "~/path/to/cache/")
@end lisp
@end defopt

Thumbnails are stored in this directory with filenames based on the video's
path and modification time. If you modify a video file, the thumbnail will be
automatically regenerated on next view.

To manually clear the thumbnail cache:

@example
M-x dired-video-thumbnail-clear-cache
@end example

@node Video Settings
@section Video Settings

@defopt dired-video-thumbnail-timestamp
Timestamp to extract thumbnail from (HH:MM:SS format). Set to @code{nil} to let
@command{ffmpeg} choose automatically. Default: @code{"00:00:05"}.

@lisp
(setq dired-video-thumbnail-timestamp "00:00:10")  ; 10 seconds in
(setq dired-video-thumbnail-timestamp "00:01:00")  ; 1 minute in
(setq dired-video-thumbnail-timestamp nil)         ; Let ffmpeg choose
@end lisp
@end defopt

@defopt dired-video-thumbnail-video-player
Command to use for playing videos. Set to @code{nil} to use system default.
Default: @code{"mpv"}.

@lisp
(setq dired-video-thumbnail-video-player "mpv")
(setq dired-video-thumbnail-video-player "vlc")
(setq dired-video-thumbnail-video-player nil)  ; Use system default
@end lisp
@end defopt

When set to @code{nil}, videos open with:
@itemize @bullet
@item Linux: @command{xdg-open}
@item macOS: @command{open}
@item Windows: System default player
@end itemize

@defopt dired-video-thumbnail-video-extensions
List of video file extensions to recognize. Default includes common formats.

@lisp
(setq dired-video-thumbnail-video-extensions
      '("mp4" "mkv" "avi" "mov" "webm" "m4v" "wmv" "flv"
        "mpeg" "mpg" "ogv" "3gp"))
@end lisp
@end defopt

@defopt dired-video-thumbnail-ffmpeg-program
@defoptx dired-video-thumbnail-ffprobe-program
Path to @command{ffmpeg} and @command{ffprobe} executables. Default: @code{"ffmpeg"}
and @code{"ffprobe"}.

@lisp
(setq dired-video-thumbnail-ffmpeg-program "/usr/local/bin/ffmpeg")
(setq dired-video-thumbnail-ffprobe-program "/usr/local/bin/ffprobe")
@end lisp
@end defopt

@node Mark Appearance
@section Mark Appearance

Marked thumbnails are indicated with a colored border.

@defopt dired-video-thumbnail-mark-border-width
Width of the border around marked thumbnails in pixels. Default: @code{4}.

@lisp
(setq dired-video-thumbnail-mark-border-width 5)
@end lisp
@end defopt

@defvr {Face} dired-video-thumbnail-mark
Face for the border around marked video thumbnails. Default foreground: red.

@lisp
(set-face-foreground 'dired-video-thumbnail-mark "blue")
@end lisp

Or via @code{use-package}:

@lisp
(use-package dired-video-thumbnail
  :custom-face
  (dired-video-thumbnail-mark ((t (:foreground "orange")))))
@end lisp
@end defvr

@node Advanced Settings
@section Advanced Settings

@defopt dired-video-thumbnail-sort-by
Default sorting criteria for thumbnails. Choices: @code{name}, @code{date},
@code{size}, @code{duration}. Default: @code{name}.

@lisp
(setq dired-video-thumbnail-sort-by 'date)
@end lisp
@end defopt

@defopt dired-video-thumbnail-sort-order
Default sort order for thumbnails. Choices: @code{ascending}, @code{descending}.
Default: @code{ascending}.

@lisp
(setq dired-video-thumbnail-sort-order 'descending)
@end lisp
@end defopt

@defopt dired-video-thumbnail-recursive
Whether to search for videos recursively in subdirectories. Default: @code{nil}.

@lisp
(setq dired-video-thumbnail-recursive t)
@end lisp
@end defopt

@defopt dired-video-thumbnail-auto-recursive
Whether to automatically search recursively when no videos in current directory.
When non-@code{nil}, if the current directory contains no video files but has
subdirectories, @code{dired-video-thumbnail} will automatically search recursively.
Default: @code{t}.

@lisp
(setq dired-video-thumbnail-auto-recursive nil)
@end lisp
@end defopt

@node Workflows
@chapter Common Workflows

@section Reviewing and Deleting Unwanted Videos

@enumerate
@item
Open a directory with videos in dired
@item
Press @kbd{C-t v} to open thumbnail view
@item
Browse thumbnails with @kbd{n}, @kbd{p}, @kbd{@key{SPC}}, or arrow keys
@item
Press @kbd{D} to delete individual videos, or mark with @kbd{m} and delete
with @kbd{x}
@end enumerate

@section Selecting Videos for Processing

@enumerate
@item
Open thumbnail view with @kbd{C-t v}
@item
Mark videos you want to process with @kbd{m}
@item
Press @kbd{d} to switch to dired
@item
Your marked videos are already selected in dired
@item
Use any dired command (@kbd{C}, @kbd{R}, @kbd{!}, etc.) on marked files
@end enumerate

@section Quick Video Preview

@enumerate
@item
In dired, position cursor on a video file
@item
Press @kbd{C-t v} to open thumbnail view
@item
Press @kbd{@key{RET}} to play the video
@item
Press @kbd{q} to return to dired
@end enumerate

@section Organizing Video Collections

@enumerate
@item
Enable recursive search with @kbd{R} or set
@code{dired-video-thumbnail-recursive} to @code{t}
@item
Sort videos by duration with @kbd{s D}
@item
Filter by size range with @kbd{/ s}
@item
Mark videos for moving or copying based on your criteria
@end enumerate

@node Troubleshooting
@chapter Troubleshooting

@section Thumbnails Not Generating

@enumerate
@item
Ensure @command{ffmpeg} is installed: @code{ffmpeg -version}
@item
Check that @command{ffmpeg} is in your @env{PATH} or set
@code{dired-video-thumbnail-ffmpeg-program}
@item
Try regenerating with @kbd{g} on a specific thumbnail
@end enumerate

@section Placeholder Showing Instead of Thumbnail

Some videos may fail to generate thumbnails if:

@itemize @bullet
@item
The video is corrupted
@item
The timestamp is beyond the video duration (try setting
@code{dired-video-thumbnail-timestamp} to @code{nil})
@item
@command{ffmpeg} doesn't support the codec
@end itemize

Press @kbd{g} on the thumbnail to retry generation.

@section Video Info Not Showing in Header Line

Ensure @command{ffprobe} is installed (it comes with @command{ffmpeg}). Set
@code{dired-video-thumbnail-ffprobe-program} if it's not in your @env{PATH}.

@section Marks Not Syncing with Dired

Run @kbd{M-x dired-video-thumbnail-debug} to check if the dired buffer is
properly associated. The output should show a live dired buffer reference.

@section Performance with Many Videos

The package processes up to 4 videos concurrently by default. For directories
with hundreds of videos, initial thumbnail generation may take some time, but
Emacs remains responsive and thumbnails appear as they complete. Thumbnails
are cached, so subsequent views are instant.

